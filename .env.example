# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# Database
DATABASE_URL=sqlite+aiosqlite:////app/data/bot.db

# Google / Vertex AI
GCP_PROJECT_ID=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=data/vertex_key.json
GEMINI_API_KEY=your_gemini_api_key

# Proxy (optional)
PROXY_URL=http://user:password@host:port

# KIE API
KIE_API_KEY=your_kie_api_key

# VK Bot
VK_BOT_TOKEN=your_vk_bot_token
VK_ADMIN_IDS=123456789

# Download service
TELEGRAM_DOWNLOAD_BASE_URL=http://your_server_ip:port

# Zveno AI
ZVENO_BASE_URL=https://api.zveno.ai/v1
ZVENO_IMAGE_EMPTY_RETRIES=2

# Feature flags
# Set to 1 to temporarily disable 4K generation (revert by removing or setting to 0)
DISABLE_4K=0
